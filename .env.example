# Copy to .env — never commit .env to git

# Supabase: Connect → ORM → Prisma
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres"

# WhatsApp (country code, no symbols)
NEXT_PUBLIC_WHATSAPP_NUMBER="60149496354"

# JWT — use a long random string in production
JWT_SECRET="replace-this-with-a-long-random-string"

# Admin login — created by prisma/seed.ts
ADMIN_EMAIL="admin@wfuwais.com"
ADMIN_PASSWORD="replace-with-strong-password"
